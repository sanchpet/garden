      "refersTo": "bib",
      "description": "A picked race as a paper bib; the number turns marker red once registered.",
      "html": "<a class=\"ds-bib\" href=\"#\"><span class=\"ds-bib-date\">12 April</span><span class=\"ds-bib-number\">21</span><span class=\"ds-bib-unit\">km</span><span class=\"ds-bib-name\">Spring Half</span><span class=\"ds-bib-status\">registered</span></a>",
      "css": ".ds-bib{display:inline-grid;grid-template-columns:auto 1fr;align-items:baseline;column-gap:.4rem;padding:.9rem 1.1rem .8rem;border:2px solid #4e4e4e;border-radius:3px 5px 4px 6px;background:radial-gradient(circle at .55rem .55rem,#b8b8b8 0 2px,transparent 2.5px),radial-gradient(circle at calc(100% - .55rem) .55rem,#b8b8b8 0 2px,transparent 2.5px),radial-gradient(circle at .55rem calc(100% - .55rem),#b8b8b8 0 2px,transparent 2.5px),radial-gradient(circle at calc(100% - .55rem) calc(100% - .55rem),#b8b8b8 0 2px,transparent 2.5px),#F5ECDC;color:#2b2b2b;text-decoration:none;transform:rotate(-.8deg);transition:transform .15s ease-out}.ds-bib:hover,.ds-bib:focus-visible{transform:rotate(0) scale(1.02)}.ds-bib>span{grid-column:1/-1}.ds-bib-date{font-size:.8rem;color:#6b6459}.ds-bib>.ds-bib-number{grid-column:1;font-family:Caveat,cursive;font-size:4.2rem;font-weight:700;line-height:.95;color:#EC0E16}.ds-bib>.ds-bib-unit{grid-column:2;font-family:Caveat,cursive;font-size:1.4rem}.ds-bib-name{font-family:Caveat,cursive;font-size:1.6rem;font-weight:700;line-height:1.1}.ds-bib>.ds-bib-status{justify-self:start;margin-top:.45rem;padding:0 .5rem;border:1.5px solid currentColor;border-radius:999px;font-size:.75rem;color:#EC0E16}"
